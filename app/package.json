{
  "name": "jmk-configurator",
  "version": "0.1.0",
  "private": true,
  "description": "Configurator for JMK keyboards",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "wasm": "cd .. && cargo build -p jmk-wasm --target wasm32-unknown-unknown --release && cp target/wasm32-unknown-unknown/release/jmk_wasm.wasm app/src/wasm/jmk.wasm",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "electron .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
